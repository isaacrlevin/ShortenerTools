<Project Sdk="Azure.Functions.Sdk">
    <PropertyGroup>
        <UserSecretsId>ec466037-9a72-4ed2-ab84-28c517f1b122</UserSecretsId>
        <!-- While .NET 11 is prerelease, this image's runtime (DOTNET_VERSION) must exactly match the SDK pinned in
             global.json, or the isolated worker exits with code 150 and the host crash-loops. 4.1055.300-3 ships
             11.0.0-rc.3.26522.148. After GA, any 11.0.x image works (e.g. floating 4-dotnet-isolated11.0-azurelinux3). -->
        <ContainerBaseImage>mcr.microsoft.com/azure-functions/dotnet-isolated:4.1055.300-3-dotnet-isolated11.0-azurelinux3</ContainerBaseImage>
        <!-- The SDK defaults this image to the non-root "app" user (UID 1654), but /azure-functions-host is root-owned
             (755) and the host creates /azure-functions-host/Secrets at startup on ACA. As UID 1654 that fails with
             "Access to the path '/azure-functions-host/Secrets' is denied" and every request returns 503. Run as root,
             like the Functions base images do by default. -->
        <ContainerUser>root</ContainerUser>
    </PropertyGroup>
    <ItemGroup>
        <None Include="local.settings.json"/>
    </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Aspire.Azure.AI.OpenAI"/>
        <PackageReference Include="Azure.AI.OpenAI"/>
        <PackageReference Include="Azure.Data.Tables"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration"/>
        <PackageReference Include="Azure.Identity"/>
        <PackageReference Include="Azure.Storage.Blobs"/>
        <PackageReference Include="Azure.Storage.Files.Shares"/>
        <PackageReference Include="Azure.Storage.Queues"/>
        <PackageReference Include="CommunityToolkit.Aspire.OllamaSharp"/>
        <PackageReference Include="cronos"/>

        <PackageReference Include="Microsoft.Azure.Functions.Worker"/>

        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http"/>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs"/>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Queues"/>

        <PackageReference Include="Microsoft.ApplicationInsights.WorkerService"/>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights"/>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.OpenTelemetry"/>
        <PackageReference Include="Microsoft.ApplicationInsights"/>

        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer"/>
        <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore"/>
        <PackageReference Include="Microsoft.Extensions.AI"/>
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI"/>
        <PackageReference Include="Microsoft.Extensions.Azure"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <PackageReference Include="OllamaSharp"/>
        <PackageReference Include="SocialPoster.Posting"/>

    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\ShortenerTools.Core\ShortenerTools.Core.csproj"/>
        <ProjectReference Include="..\ShortenerTools.ServiceDefaults\ShortenerTools.ServiceDefaults.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <None Update="host.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.Threading.ExecutionContext" Alias="ExecutionContext"/>
        <InternalsVisibleTo Include="ShortenerTools.Tests"/>
    </ItemGroup>

    <!-- Azure.Functions.Sdk always sets the Debian images' /opt/startup/start_nonappservice.sh entrypoint, which the
         -azurelinux3 images don't have. That script only installs custom CA certificates and then runs the host binary,
         so start the host directly. Applies only when the base image is an -azurelinux3 tag. -->
    <Target Name="UseAzureLinuxFunctionsHostEntrypoint" AfterTargets="AssignFunctionsBaseImage"
            Condition="$(ContainerBaseImage.Contains('-azurelinux3'))">
        <ItemGroup>
            <ContainerAppCommand Remove="@(ContainerAppCommand)"/>
            <ContainerAppCommand Include="/azure-functions-host/Microsoft.Azure.WebJobs.Script.WebHost"/>
        </ItemGroup>
    </Target>
</Project>
